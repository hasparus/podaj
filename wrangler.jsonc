{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podaj",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-11",
  "observability": { "enabled": false },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/s/*", "/api/*", "/parties/*", "/authorize", "/authorize/", "/authorize.html"]
  },
  "ratelimits": [
    {
      "name": "PUBLIC_API_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HANDOFF_PARTY",
        "class_name": "HandoffParty"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-handoff-party",
      "new_sqlite_classes": ["HandoffParty"]
    }
  ],
  "vars": {
    "PODAJ_ACCESS": "private",
    "MAX_HANDOFF_BYTES": "32768",
    "HANDOFF_TTL_SECONDS": "7200"
  }
}
