{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podaj",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "HANDOFFS",
      "id": "00000000000000000000000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HANDOFF_PARTY",
        "class_name": "HandoffParty"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-handoff-party",
      "new_sqlite_classes": ["HandoffParty"]
    }
  ],
  "vars": {
    "MAX_HANDOFF_BYTES": "32768"
  }
}
