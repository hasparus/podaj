{
  "name": "podaj",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm run typecheck && pnpm run lint",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vite build && wrangler dev",
    "keygen": "node scripts/keygen.mjs",
    "decrypt": "node scripts/decrypt-handoff.mjs",
    "lint": "oxlint -c oxlint.config.ts",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true",
    "test": "vitest run",
    "typecheck": "tsrs --noEmit -p tsconfig.json && tsrs --noEmit -p tsconfig.scripts.json",
    "typecheck:scripts": "tsrs --noEmit -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@cloudflare/workers-types": "4.20251011.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@types/node": "24.19.2",
    "@yielded/effect-tsrs": "0.2.3",
    "alchemy": "2.0.0-beta.85",
    "lefthook": "2.2.2",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.45.0"
  },
  "dependencies": {
    "@foldkit/vite-plugin": "0.29.0",
    "@fontsource/commit-mono": "^5.3.0",
    "effect": "4.1.2",
    "foldkit": "0.170.0"
  }
}
