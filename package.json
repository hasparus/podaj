{
  "name": "podaj",
  "version": "0.1.1",
  "description": "One-shot encrypted env handoff. Deploy your own Worker, then hand variables over a link.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasparus/podaj.git"
  },
  "bin": {
    "podaj": "dist/scripts/podaj.js"
  },
  "files": [
    "dist/scripts",
    "dist/src",
    "src",
    "dist/client",
    "wrangler.jsonc",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun run build:cli && vite build",
    "build:cli": "rm -rf dist/scripts dist/src && tsc -p tsconfig.scripts.build.json && chmod +x dist/scripts/podaj.js dist/scripts/hooks/block-git-no-verify.js",
    "cf:test": "bun scripts/cloudflare.ts test",
    "cf:demo": "bun scripts/cloudflare.ts demo",
    "prepack": "bun run build",
    "check": "bun run typecheck && bun run lint",
    "deploy": "bun run build && wrangler deploy",
    "dev": "vite build && wrangler dev",
    "canvas": "vite --host 127.0.0.1 --open /dev/canvas.html",
    "podaj": "bun scripts/podaj.ts",
    "keygen": "bun scripts/podaj.ts keygen",
    "decrypt": "bun scripts/podaj.ts decrypt",
    "lint": "oxlint -c oxlint.config.ts",
    "prepare": "[ ! -f scripts/prepare.ts ] || bun scripts/prepare.ts",
    "test": "bun run build && vitest run",
    "typecheck": "tsrs --noEmit -p tsconfig.json && tsrs --noEmit -p tsconfig.scripts.json",
    "typecheck:scripts": "tsrs --noEmit -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251011.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@types/node": "24.19.2",
    "@types/ws": "^8.18.2",
    "@yielded/effect-tsrs": "0.2.3",
    "esbuild": "0.25.4",
    "lefthook": "2.2.2",
    "miniflare": "4.20251011.1",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@foldkit/vite-plugin": "0.29.0",
    "@fontsource/commit-mono": "^5.3.0",
    "age-encryption": "0.3.1",
    "effect": "4.1.2",
    "foldkit": "0.170.0",
    "jsonc-parser": "3.3.1",
    "pixelarticons": "2.4.2",
    "wrangler": "4.45.0",
    "ws": "^8.22.1"
  }
}
